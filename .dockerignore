# Only backend build inputs enter the Docker context.
**
!backend/
!backend/requirements.txt
!backend/alembic.ini
!backend/app/
!backend/app/**
!backend/migrations/
!backend/migrations/**
!shared/
!shared/**
!docker/
!docker/Dockerfile.backend

# Exclude runtime files even if created beneath a source directory.
**/__pycache__/
**/*.py[cod]
**/.env
**/.env.*
**/*.db
**/*.sqlite*
**/*.log
**/*.bak
**/*.tmp
**/*.pem
**/*.key
**/uploads/

# Golden vectors are test inputs, not production application data.
shared/*_cases.json
