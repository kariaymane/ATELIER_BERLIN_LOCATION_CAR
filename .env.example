# ===========================================
# Car Rental System - Environment Variables
# ===========================================
# Copy this file to .env and fill in real values.
# NEVER commit .env with real secrets to Git.

# ---- Database ----
DATABASE_URL=postgresql+asyncpg://rental_app:CHANGE_ME@localhost:5432/car_rental
DATABASE_URL_SYNC=postgresql://rental_app:CHANGE_ME@localhost:5432/car_rental

# ---- JWT ----
JWT_SECRET=CHANGE_ME_GENERATE_A_SECURE_RANDOM_STRING
JWT_REFRESH_SECRET=CHANGE_ME_GENERATE_ANOTHER_SECURE_RANDOM_STRING
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256

# ---- Security ----
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT=100/minute
ALLOWED_UPLOAD_EXTENSIONS=.jpg,.jpeg,.png,.pdf,.webp
MAX_UPLOAD_SIZE_MB=10

# ---- Server ----
HOST=0.0.0.0
PORT=8000
DEBUG=false
LOG_LEVEL=info

# ---- Default Admin (first run only) ----
ADMIN_EMAIL=BERLINCAR@GMAIL.COM
ADMIN_PASSWORD=CHANGE_ME_USE_STRONG_PASSWORD
ADMIN_FULLNAME=Administrateur Système
