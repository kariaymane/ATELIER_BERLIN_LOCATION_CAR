# Copy to .env and fill in. NEVER commit the filled-in file.
#
# Production values are NOT stored here. They live in `fly secrets` for the
# deployed API and in GitHub Actions secrets for CI. This file documents which
# variables exist and what shape they take — nothing more.

# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://localhost:5432/car_rental
DATABASE_URL_SYNC=postgresql://localhost:5432/car_rental

# Connection pool. pool_size + max_overflow is the hard ceiling on server-side
# connections one worker opens; keep it well under the database's max_connections.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# ── JWT ─────────────────────────────────────────────────────────────────────
# Generate each independently, e.g. `python -c "import secrets;print(secrets.token_urlsafe(64))"`.
# The two MUST differ: reusing one secret lets a refresh token be replayed as an access token.
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256

# ── Security ────────────────────────────────────────────────────────────────
# Empty means no browser origin is allowed. The desktop and mobile clients are
# native and do not need CORS, so leave this empty unless a web client exists.
CORS_ORIGINS=
RATE_LIMIT=100/minute
MAX_UPLOAD_SIZE_MB=10

# ── Server ──────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
# Must stay false outside local development: it enables SQL echo.
DEBUG=false
LOG_LEVEL=info

# ── Initial administrator ───────────────────────────────────────────────────
# Used ONCE, to seed the first account on an empty database. It does not change
# an existing account's password — rotate that through POST /auth/change-password.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FULLNAME=Administrateur Système
