# ─── Secrets and local environment ──────────────────────────────────────────
# Never commit a real credential. Deployment secrets live in `fly secrets`,
# CI secrets in GitHub Actions secrets, local values in an untracked .env.
.env
.env.*
!.env.example
backend/.env
backend/.env.*
docker/.env
mobile/.env

# Android signing identities. Losing control of one is unrecoverable: it can
# never be rotated for an app already published under it. Keep them outside
# this directory entirely and point KEYSTORE_PATH at them.
*.jks
*.keystore

# ─── Python ─────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
.Python
venv/
.venv/
env/

# ─── Tests and coverage ─────────────────────────────────────────────────────
.pytest_cache/
htmlcov/
.coverage
.coverage.*
coverage.xml

# ─── Build output ───────────────────────────────────────────────────────────
build/
dist/
dist_final/
artifacts_archive/
packaging/windows/build/
packaging/windows/dist/
packaging/windows/venv_wine/

# Release artifacts are published through GitHub Releases, not committed.
ATELIER_BERLIN_LOCATION_CAR*.apk
ATELIER_BERLIN_LOCATION_CAR*.exe
ATELIER_BERLIN_LOCATION_CAR*.zip
atelier-berlin-location-car-*.zip
*.aab

# ─── Android / Gradle ───────────────────────────────────────────────────────
.gradle/
**/build/
mobile/local.properties
mobile/.idea/
mobile/.kotlin/
mobile/captures/
*.iml

# ─── Runtime data ───────────────────────────────────────────────────────────
# Client documents and local databases hold personal data. They belong on the
# server volume and on the operator's machine, never in version control.
uploads/
*.db
*.sqlite
*.sqlite3
desktop/app/data/device_id.txt

# ─── Backups and scratch files ──────────────────────────────────────────────
backups/
.backups/
*.sql
!docker/postgres/init.sql
*.dump
*.backup
*.backup.*
*.bak
*.bak.*
*.old
*.orig
*.rej
*.tmp
*.tar.gz
*.tgz
fly.toml.backup-*
window_dump.xml

# ─── Logs ───────────────────────────────────────────────────────────────────
*.log
logs/

# ─── Editors and OS ─────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Roborazzi screenshot output. These are regenerated by `./gradlew testDebugUnitTest`
# in record mode; committing them adds binary churn with no review value.
mobile/app/src/test/screenshots/
