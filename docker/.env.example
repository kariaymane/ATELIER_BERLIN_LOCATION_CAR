# Copy to docker/.env and provide independent values from a password manager.
# Use URL-safe database passwords, or URL-encode them before DSN interpolation.
POSTGRES_DB=car_rental
POSTGRES_USER=rental_app
POSTGRES_PASSWORD=
JWT_SECRET=
JWT_REFRESH_SECRET=

# Optional first-run administrator. Remove ADMIN_PASSWORD after provisioning.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FULLNAME=Administrator

# Bind the API to loopback behind an HTTPS reverse proxy in production.
API_BIND_ADDRESS=127.0.0.1
API_PORT=8000
CORS_ORIGINS=
