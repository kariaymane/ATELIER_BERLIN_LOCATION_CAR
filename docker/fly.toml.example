# Copy to docker/fly.toml; set your own app name, region, and volume.
app = "replace-with-your-app-name"

[build]
  dockerfile = "docker/Dockerfile.backend"

[deploy]
  release_command = "alembic upgrade head"

[http_service]
  internal_port = 8000
  force_https = true
  # Realtime broadcasts are process-local. Use one application instance.
  auto_stop_machines = "suspend"
  auto_start_machines = true
  min_machines_running = 1
  processes = ["app"]

[[vm]]
  memory = "1gb"
  cpus = 1

[[mounts]]
  source = "uploads"
  destination = "/app/uploads"
